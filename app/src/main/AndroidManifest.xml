<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- normal 级权限：安装即授予，无任何运行时弹窗 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- 零界面应用：不声明任何 <activity>，无启动器入口 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- 磁贴：音量 +1 -->
        <service
            android:name=".tile.VolumeUpTileService"
            android:icon="@drawable/ic_volume_up"
            android:label="@string/tile_up_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE"
                android:resource="@xml/tile_volume_up" />
            <!-- API 36.1（Android 16 QPR1）磁贴编辑页分类；旧系统自动忽略 -->
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_DISPLAY" />
        </service>

        <!-- 磁贴：音量 -1 -->
        <service
            android:name=".tile.VolumeDownTileService"
            android:icon="@drawable/ic_volume_down"
            android:label="@string/tile_down_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE"
                android:resource="@xml/tile_volume_down" />
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_DISPLAY" />
        </service>
    </application>

</manifest>
