<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      前台服务权限（Android 17 Background audio hardening 适配）：
      两者均为 normal 级、安装即授予，无任何运行时弹窗。

      ⚠️ 不需要 MODIFY_AUDIO_SETTINGS：媒体流（STREAM_MUSIC）的音量调节不校验该权限。
      ⚠️ 不声明 FOREGROUND_SERVICE_MEDIA_PLAYBACK：本应用并不播放音频，
         声明媒体播放类型语义不实，且会让系统按媒体会话治理该服务。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 零界面应用：不声明任何 <activity>，无启动器入口 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- 磁贴：音量 +1 -->
        <service
            android:name=".tile.VolumeUpTileService"
            android:icon="@drawable/ic_volume_up"
            android:label="@string/tile_up_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- API 36.1（Android 16 QPR1）磁贴编辑页分类；旧系统自动忽略 -->
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_DISPLAY" />
        </service>

        <!-- 磁贴：音量 -1 -->
        <service
            android:name=".tile.VolumeDownTileService"
            android:icon="@drawable/ic_volume_down"
            android:label="@string/tile_down_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_DISPLAY" />
        </service>

        <!--
          音量调节前台服务（v2.0 / Android 17 加固适配）

          作用：磁贴点击时短暂转前台，使音量调用通过 Android 17 的
          Background audio hardening 校验，然后立即退出（不常驻）。

          android:exported="false"：仅本应用内部使用，不对外暴露。
          foregroundServiceType="specialUse"：见 VolumeAdjustService 类注释的选型理由。
        -->
        <service
            android:name=".volume.VolumeAdjustService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Transient foreground service used to apply a single media volume change on behalf of a Quick Settings tile click, required by Android 17 background audio hardening." />
        </service>
    </application>

</manifest>
